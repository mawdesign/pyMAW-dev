<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brick / Paver Bump Atlas" Height="860" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#333333">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#666"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Bump Atlas" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

            <Label Content="Pattern"/>
            <ComboBox Name="cmbPattern"/>

            <Label Content="Material"/>
            <ComboBox Name="cmbMaterial"/>

            <Label Content="Unit width / height / joint (mm)"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Name="txtWidth" Text="230" Width="60"/>
                <TextBlock Text="x" Foreground="White" Margin="8,0"/>
                <TextBox Name="txtHeight" Text="76" Width="60"/>
                <TextBlock Text="+" Foreground="White" Margin="8,0"/>
                <TextBox Name="txtMortar" Text="10" Width="60"/>
            </StackPanel>

            <Label Content="Board length (basketweave / herringbone, mm)"/>
            <TextBox Name="txtLength" Text="609.6" Width="80" HorizontalAlignment="Left"/>

            <Separator Margin="0,10,0,0" Background="#444"/>

            <Label Content="Pit level (0 = none)"/>
            <Slider Name="sliderPits" Minimum="0" Maximum="3" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <Label Content="Scratch level (0 = none)"/>
            <Slider Name="sliderScratch" Minimum="0" Maximum="3" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <Label Content="Joint level (0 black - 1 white)"/>
            <Slider Name="sliderJoint" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05"/>

            <Label Content="Minimum atlas size (mm) / pixels per mm / seed"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Name="txtMinSize" Text="800" Width="60"/>
                <TextBlock Text="/" Foreground="White" Margin="8,0"/>
                <TextBox Name="txtPpm" Text="2" Width="40"/>
                <TextBlock Text="/" Foreground="White" Margin="8,0"/>
                <TextBox Name="txtSeed" Text="1" Width="40"/>
            </StackPanel>

            <CheckBox Name="chkOutline" Content="Preview 1 px cell outlines (not saved)" Foreground="White" Margin="0,12,0,0" IsChecked="True"/>
            <CheckBox Name="chkColour" Content="Preview on colour (hex) - not saved" Foreground="White" Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox Name="txtColour" Text="#A8553A" Width="80"/>
                <Label Content="bump strength" Margin="10,0,0,0"/>
                <Slider Name="sliderBump" Minimum="0" Maximum="1" Value="0.2" Width="90" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox Name="chkTile" Content="Preview 2 x 2 tiled (check seams)" Foreground="White" Margin="0,12,0,0"/>

            <Button Name="btnGenerate" Content="GENERATE" Height="40" Margin="0,18,0,0" FontWeight="Bold" Background="#007ACC" Foreground="White"/>
            <Button Name="btnSave" Content="SAVE PNG" Height="30" Margin="0,10,0,0" FontWeight="Bold" Background="#444" Foreground="White"/>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Name="statusText" Text="Ready" HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Name="sizeText" Text="" HorizontalAlignment="Center" FontSize="12" Foreground="#FFCC00" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Name="timeText" Text="Time: --" HorizontalAlignment="Center" FontSize="11" Foreground="#00CC00" Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="#555" BorderThickness="1" Background="#222">
            <Grid>
                <Image Name="imgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Name="placeholderText" Text="Click Generate..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666"/>
            </Grid>
        </Border>
    </Grid>
</Window>
