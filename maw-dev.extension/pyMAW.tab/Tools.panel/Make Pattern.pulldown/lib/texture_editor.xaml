<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texture Editor"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Width="1000" Height="760"
        Background="White"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Controls -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Name="NoteText" TextWrapping="Wrap" Foreground="#AA4400" Margin="0,0,0,8" Visibility="Collapsed"
                       Text="Apply Texture is off: the maps will have plain faces. Colours and joint depth still apply."/>

            <GroupBox Name="TextureGroup" Header="Texture" FontWeight="Bold" Margin="0,0,0,10">
                <StackPanel Margin="10" TextBlock.FontWeight="Normal">
                    <TextBlock Text="Base texture" Margin="0,0,0,3"/>
                    <ComboBox Name="MaterialCombo" Height="24" Margin="0,0,0,10"/>

                    <DockPanel><TextBlock Text="Pits (0 = none)"/><TextBlock Name="PitsValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider Name="PitsSlider" Minimum="0" Maximum="3" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"/>

                    <DockPanel><TextBlock Text="Scratches (0 = none)"/><TextBlock Name="ScratchValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider Name="ScratchSlider" Minimum="0" Maximum="3" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"/>

                    <DockPanel Margin="0,0,0,3"><TextBlock Text="Seed (changes the base texture)"/></DockPanel>
                    <TextBox Name="SeedInput" Text="1" Width="80" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Joint and lighting" FontWeight="Bold" Margin="0,0,0,10">
                <StackPanel Margin="10" TextBlock.FontWeight="Normal">
                    <DockPanel><TextBlock Text="Joint depth"/><TextBlock Name="DepthValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider Name="DepthSlider" Minimum="0" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="True"/>

                    <DockPanel><TextBlock Text="Preview relief (preview only)"/><TextBlock Name="ReliefValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider Name="ReliefSlider" Minimum="0" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Colours" FontWeight="Bold" Margin="0,0,0,10">
                <Grid Margin="10" TextBlock.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Name="BrickLabel" Text="Brick face" Margin="0,0,0,3" TextWrapping="Wrap"/>
                        <Button Name="BrickSwatch" Height="28" BorderBrush="Black" BorderThickness="1" Click="BrickSwatch_Click"/>
                        <TextBox Name="BrickHex" Margin="0,4,0,0" MaxLength="9"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Name="MortarLabel" Text="Mortar joint" Margin="0,0,0,3" TextWrapping="Wrap"/>
                        <Button Name="MortarSwatch" Height="28" BorderBrush="Black" BorderThickness="1" Click="MortarSwatch_Click"/>
                        <TextBox Name="MortarHex" Margin="0,4,0,0" MaxLength="9"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button Name="OkButton" Content="OK" Width="100" Height="30" Margin="0,0,10,0" IsDefault="True" Click="OkButton_Click"/>
                <Button Name="CancelButton" Content="Cancel" Width="100" Height="30" IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Preview -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#EEEEEE" BorderBrush="#BBBBBB" BorderThickness="1">
                <Grid>
                    <Image Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Name="PlaceholderText" Text="Rendering..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Name="StatusText" TextWrapping="Wrap" Text=""/>
                <TextBlock Name="SizeText" TextWrapping="Wrap" FontWeight="Bold" Margin="0,3,0,0" Text=""/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
